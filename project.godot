; Minimal project so `godot --headless --path . --script` has a context to
; run in. export/main.tscn exists only so the desktop export presets have a
; main scene. Nothing here is a game.

config_version=5

[application]

config/name="haiven-godot-spike"
config/features=PackedStringArray("4.4")
run/main_scene="res://export/main.tscn"

[rendering]

textures/vram_compression/import_etc2_astc=true
